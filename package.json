{
  "name": "axiom-standard-base-app",
  "version": "1.0.9",
  "private": true,
  "description": "Reusable source-code foundation for future Axiom standard apps.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build --webpack",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:setup": "tsx prisma/setup-production.ts",
    "db:seed-demo": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "lucide-react": "0.468.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.10",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "4.1.9"
  }
}
